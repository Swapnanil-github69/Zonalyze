{
  "name": "zonalyze-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Objective Location Intelligence and Grounded Environmental Risk Debriefs",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"api,web\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "keywords": [
    "location-intelligence",
    "gis",
    "maplibre",
    "environmental-risk",
    "gemini"
  ],
  "author": "Zonalyze Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
